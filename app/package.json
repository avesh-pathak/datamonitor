{
  "name": "taskbar-data-monitor",
  "version": "0.1.0",
  "description": "Local-only network usage monitor with a taskbar readout",
  "author": "Avesh Pathak <https://avesh.tech>",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder --win"
  },
  "build": {
    "appId": "tech.avesh.data-monitor",
    "productName": "Data Monitor",
    "copyright": "Copyright © 2026 Avesh Pathak",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Data Monitor",
      "artifactName": "Data-Monitor-Setup.${ext}"
    },
    "portable": {
      "artifactName": "Data-Monitor-Portable.${ext}"
    },
    "asar": true,
    "asarUnpack": [
      "**/*.ps1"
    ]
  },
  "dependencies": {
    "koffi": "^2.14.1"
  },
  "devDependencies": {
    "electron": "^45.1.0",
    "electron-builder": "^25.1.8"
  }
}
